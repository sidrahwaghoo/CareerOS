# ---------------------------------------------------------------------------
# Credensa backend configuration
# Copy this file to .env in the backend folder:
#   cp .env.example .env        (macOS / Linux)
#   copy .env.example .env      (Windows PowerShell)
# Never commit the real .env — it contains secrets.
#
# ALL credentials below are REQUIRED. There is no fallback storage and no
# simulated AI responses. The backend refuses to start without valid Firebase
# credentials, and AI endpoints fail fast with a clear error if the Gemini key
# is missing.
# ---------------------------------------------------------------------------

# Port the Express server listens on. Cloud Run injects its own PORT at
# runtime; 3001 is the local default and the documented production port.
PORT=3001

# Runtime mode: "development" locally, "production" on Cloud Run.
NODE_ENV=development

# ---------------------------------------------------------------------------
# Firebase / Firestore (persistence) — REQUIRED
# ---------------------------------------------------------------------------
# All three FIREBASE_* values must be set. If any is missing the backend
# throws at startup and will not run. On Cloud Run these are injected from
# Secret Manager rather than a .env file.

# Your Firebase / GCP project ID.
FIREBASE_PROJECT_ID=credensa-buildathon

# Service-account email from Firebase console > Project settings > Service accounts.
FIREBASE_CLIENT_EMAIL=

# Service-account private key (the full PEM block). Keep it on ONE line and
# escape newlines as \n, e.g. "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n".
# The backend converts \n back to real newlines when initializing Firebase.
FIREBASE_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Google AI (Gemini) — powers the Match, Draft and Review agents — REQUIRED
# ---------------------------------------------------------------------------
# A valid key from Google AI Studio (https://aistudio.google.com/app/apikey)
# is required. Without it the server still starts, but every AI endpoint throws
# a clear "GEMINI_API_KEY is not configured" error instead of returning fake
# data. The key is only used on the backend and is never exposed to the browser.
GEMINI_API_KEY=

# Gemini model used for all agent calls.
GEMINI_MODEL=gemini-2.0-flash

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
# Origin allowed to call the API from a browser during local development
# (the Vite dev server). In production the built frontend is served from the
# same origin on Cloud Run, so this can be left as-is or set to your service URL.
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Required environment variable checklist
#   FIREBASE_PROJECT_ID      -> required (startup fails if missing)
#   FIREBASE_CLIENT_EMAIL    -> required (startup fails if missing)
#   FIREBASE_PRIVATE_KEY     -> required (startup fails if missing)
#   GEMINI_API_KEY           -> required for all AI endpoints
#   GEMINI_MODEL             -> optional (defaults to gemini-2.0-flash)
#   FRONTEND_URL             -> optional CORS origin
#   PORT, NODE_ENV           -> optional
# ---------------------------------------------------------------------------

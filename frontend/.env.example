# ---------------------------------------------------------------------------
# Credensa frontend configuration
# Copy this file to `.env` in the frontend folder:
#   cp .env.example .env        (macOS / Linux)
#   copy .env.example .env      (Windows PowerShell)
# Values prefixed with VITE_ are compiled into the client bundle — never put
# secret keys here. Firebase web config is public by design; the ID token it
# produces is what authenticates requests to the backend.
# ---------------------------------------------------------------------------

# Firebase Web App config (Firebase console > Project settings > Your apps).
# All four values are REQUIRED. There is no default project and no fallback.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Backend API base URL. Leave empty in local development to use the Vite
# proxy (http://localhost:3001/api). Set to your deployed /api URL in prod.
VITE_API_URL=
